{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ela Maayan content recipe registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checked_on",
    "classification_mode",
    "axes",
    "rules",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "checked_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "classification_mode": {
      "const": "transparent_keyword_assistance_not_semantic_ai"
    },
    "axes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "required": [
        "format",
        "placement",
        "audience_stage",
        "purpose",
        "cta",
        "campaign",
        "asset_mode"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scope",
        "status",
        "formats",
        "narrative_structure",
        "possible_purposes",
        "suggested_audience_stages",
        "required_inputs",
        "proof_requirements",
        "cta_policy",
        "output_contract",
        "skills",
        "quality_checks",
        "match_signals",
        "example_briefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "generic",
            "ela_maayan"
          ]
        },
        "status": {
          "enum": [
            "starter",
            "experimental",
            "established",
            "retired"
          ]
        },
        "cta_policy": {
          "const": "optional"
        },
        "formats": {
          "$ref": "#/$defs/strings"
        },
        "narrative_structure": {
          "$ref": "#/$defs/strings"
        },
        "possible_purposes": {
          "$ref": "#/$defs/strings"
        },
        "suggested_audience_stages": {
          "$ref": "#/$defs/strings"
        },
        "required_inputs": {
          "$ref": "#/$defs/strings"
        },
        "proof_requirements": {
          "$ref": "#/$defs/strings"
        },
        "output_contract": {
          "$ref": "#/$defs/strings"
        },
        "skills": {
          "$ref": "#/$defs/strings"
        },
        "quality_checks": {
          "$ref": "#/$defs/strings"
        },
        "example_briefs": {
          "$ref": "#/$defs/strings"
        },
        "match_signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phrases",
              "weight"
            ],
            "properties": {
              "phrases": {
                "$ref": "#/$defs/strings"
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        }
      }
    }
  }
}
